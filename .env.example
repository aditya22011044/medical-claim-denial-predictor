# ---------------------------------------------------------------------------
# LLM provider - NVIDIA NIM (OpenAI-compatible endpoint).
# Copy this file to `.env` and fill in your real key. NEVER commit `.env`.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=

# NVIDIA NIM API base URL (OpenAI-compatible).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------------------
# LLM settings
# ---------------------------------------------------------------------------
# Optional: override the ordered model fallback chain (comma-separated, tried in
# order). Leave commented out to use the built-in chain.
# NVIDIA_MODELS=nvidia/nemotron-3.5-bolt-e4b,nvidia/nemotron-3.5-lightning-30b-a3b,minimaxai/minimax-m3.1-flash,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-super-vl-120b-a12b,moonshotai/kimi-k3.1-pro,mistralai/mistral-large-4-1t-a52b,stepfun-ai/step-5-preview,z-ai/glm-5.3-flash

# Request timeout in seconds and how many times a rate-limited model is retried.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Denial-reason predictions are only returned when the denial probability is at
# least this value (keeps the reason model from guessing on low-risk claims).
DENIAL_REASON_MIN_PROBABILITY=0.35
