# ---------------------------------------------------------------------------
# LLM API keys - ordered pool of up to 10 independently authorised keys.
# Copy this file to `.env` and fill in your real keys. NEVER commit `.env`.
# ---------------------------------------------------------------------------
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_API_KEY_5=
OPENAI_API_KEY_6=
OPENAI_API_KEY_7=
OPENAI_API_KEY_8=
OPENAI_API_KEY_9=
OPENAI_API_KEY_10=

# ---------------------------------------------------------------------------
# LLM settings
# ---------------------------------------------------------------------------
# Model name used for recommendation generation (any chat-completions model).
LLM_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=

# Request timeout in seconds and how many times a rate-limited key is retried.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Denial-reason predictions are only returned when the denial probability is at
# least this value (keeps the reason model from guessing on low-risk claims).
DENIAL_REASON_MIN_PROBABILITY=0.35
